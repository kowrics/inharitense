APP_ENV=production
SECRET_KEY=generate-a-long-random-secret

# Used by docker-compose.yml to configure the "db" (PostgreSQL) container.
# Keep these in sync with the credentials embedded in DATABASE_URL below.
POSTGRES_DB=inharitense
POSTGRES_USER=inharitense
POSTGRES_PASSWORD=replace-with-a-strong-password

# Host must be "db" (the docker-compose service name) when running under Docker Compose.
# If you run app.py directly on your own machine against a local/remote Postgres instead,
# use that host's actual address (e.g. localhost) here.
DATABASE_URL=postgresql://inharitense:replace-with-a-strong-password@db:5432/inharitense

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEFAULT_TEMP_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_NAME=HR Administrator
BOOTSTRAP_ADMIN_EMAIL=hr-admin@your-company.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
SMTP_HOST=smtp.your-company.com
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=inventory@your-company.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=inventory@your-company.com
